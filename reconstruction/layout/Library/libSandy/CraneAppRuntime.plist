<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Main ' Crane.dylib' can run in arbitrary third-party bundles.
         Allow only a single Mach lookup needed by its runtime attestation.
         Unlike the system CraneSupport/CraneRB profiles, this app-specific
         extension MUST NOT grant filesystem access or any other service. -->
    <key>AllowedProcesses</key>
    <array>
        <string>*</string>
    </array>
    <key>Extensions</key>
    <array>
        <dict>
            <key>type</key>
            <string>mach</string>
            <key>extension_class</key>
            <string>com.apple.app-sandbox.mach</string>
            <key>mach_name</key>
            <string>com.opa334.cranehelperd.xpc</string>
        </dict>
    </array>
</dict>
</plist>
